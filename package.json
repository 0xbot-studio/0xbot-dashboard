{
  "name": "0xbot-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "dev": "vite --host 127.0.0.1 --port 3192 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "tsc -b && prettier --check src vite.config.ts",
    "format": "prettier --write src vite.config.ts",
    "generate:api": "node scripts/generate-api.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "8.2.2"
  }
}
